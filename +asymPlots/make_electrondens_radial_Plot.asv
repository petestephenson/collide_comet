function [f, ax] = make_electrondens_radial_Plot(peCasesNo, swCasesNo, plasDensDir)


    %% NEED TO WEIGHT THE BOXES BY THE VOLUME AS THE SMALLER BOXES ARE OVERREPRESENTED IN THE MEDIAN CALCULATION..
%MAKE_ELECTRONDENS_RADIAL_PLOT Plot median electron density vs radius.
%
% Subplots:
%   1. Total electron density
%   2. Cold electron density
%   3. Cold / total density ratio
%
% Each asymmetric simulation is split along its asymmetry axis:
%   coord > 0 and coord < 0

    % ----------------------------
    % Plot settings
    % ----------------------------
    cometaryu
    plot_lim = 300;   % km
    nBins = 50;

    caseNameList = {'Ref', '-X', '+Y', '+Z', '-Z'};
    caseOrder = 1:5;
    caseColors = lines(numel(caseOrder));

    % Ref has no asymmetry axis, so it is plotted without splitting.
    asymAxisList = {'none', 'X', 'Y', 'Z', 'Z'};

    inc_gens = [1, 2];
    minEng = 0;
    maxEng = 1;

    % ----------------------------
    % Create figure/subplots
    % ----------------------------
    f = figure( ...
        'Position', [100, 100, 1300, 500], ...
        'Color', 'w' ...
    );

    t = tiledlayout(f, 1, 3, ...
        'TileSpacing', 'compact', ...
        'Padding', 'compact');

    ax = gobjects(1, 3);

    ax(1) = nexttile(t, 1);
    ax(2) = nexttile(t, 2);
    ax(3) = nexttile(t, 3);

    for iAx = 1:3
        hold(ax(iAx), 'on');
        box(ax(iAx), 'on');
        grid(ax(iAx), 'on');

        set(ax(iAx), ...
            'FontSize', 12, ...
            'LineWidth', 1.1, ...
            'TickDir', 'out');
    end

    % ----------------------------
    % Radial bins
    % ----------------------------
    r_edges = linspace(0, plot_lim, nBins + 1);
    r_centres = r_edges(1:end-1) + 0.5 * diff(r_edges);

    % ----------------------------
    % Main loop
    % ----------------------------
    for iCase = caseOrder

        peAsymNo = peCasesNo{iCase};
        swAsymNo = swCasesNo{iCase};

        peAsymName = fullfile(plasDensDir, ['plas_dens', peAsymNo, '.nc']);
        swAsymName = fullfile(plasDensDir, ['plas_dens', swAsymNo, '.nc']);

        [gridsAsym, plas_dens_E_Asym_pe] = asymPlots.loadRunData(peAsymName);
        [~,         plas_dens_E_Asym_sw] = asymPlots.loadRunData(swAsymName);

        plas_dens_E_Asym = plas_dens_E_Asym_sw + plas_dens_E_Asym_pe;

        [plas_dens_asym, plas_dens_cold_asym] = asymPlots.calculatePlasmaDensities( ...
            gridsAsym, ...
            plas_dens_E_Asym, ...
            inc_gens, ...
            minEng, ...
            maxEng ...
        );

        % ----------------------------
        % Build spatial mesh
        % ----------------------------
        x = gridsAsym{1}(1:end-1);
        y = gridsAsym{2}(1:end-1);
        z = gridsAsym{3}(1:end-1);

        [X_mesh, Y_mesh, Z_mesh] = meshgrid(x, y, z);
        rMesh = sqrt(X_mesh.^2 + Y_mesh.^2 + Z_mesh.^2);

        dx = diff(gridsAsym{1});
        dy = diff(gridsAsym{2});
        dz = diff(gridsAsym{3});

        [dX, dY, dZ] = meshgrid(dx, dy, dz);
        dV = dX .* dY .* dZ;

        % Match density orientation to meshgrid output
        dens_total = permute(plas_dens_asym, [2, 1, 3]);
        dens_cold  = permute(plas_dens_cold_asym, [2, 1, 3]);

        if ~isequal(size(rMesh), size(dens_total))
            error( ...
                ['Size mismatch: rMesh is %s but total density is %s. ', ...
                 'Check whether permute(plas_dens_asym,[2,1,3]) is correct.'], ...
                mat2str(size(rMesh)), ...
                mat2str(size(dens_total)) ...
            );
        end

        if ~isequal(size(rMesh), size(dens_cold))
            error( ...
                ['Size mismatch: rMesh is %s but cold density is %s. ', ...
                 'Check whether permute(plas_dens_cold_asym,[2,1,3]) is correct.'], ...
                mat2str(size(rMesh)), ...
                mat2str(size(dens_cold)) ...
            );
        end

        % ----------------------------
        % Determine split coordinate
        % ----------------------------
        asymAxis = asymAxisList{iCase};

        switch asymAxis
            case 'X'
                coordMesh = X_mesh;
            case 'Y'
                coordMesh = Y_mesh;
            case 'Z'
                coordMesh = Z_mesh;
            case 'none'
                coordMesh = [];
                [qSpherical, qDayside, qUniform, qVec] = asymPlots.loadOutgassingProperties(peAsymName);
                Q_ref = qSpherical;
            otherwise
                error('Unknown asymmetry axis: %s', asymAxis);
        end

        % ----------------------------
        % Reference case: no split
        % ----------------------------
        if strcmp(asymAxis, 'none')

            mask = true(size(rMesh));
            labelStr = caseNameList{iCase};

            % [median_total, median_cold, ratio_cold_total] = calcMedianProfiles( ...
            %     rMesh, ...
            %     dens_total, ...
            %     dens_cold, ...
            %     mask, ...
            %     r_edges, ...
            %     nBins, ...
            %     plot_lim ...
            % );
            [mean_total_pos, mean_cold_pos, ratio_pos] = calcVolumeWeightedProfiles( ...
                rMesh, ...
                dens_total, ...
                dens_cold, ...
                dV, ...
                mask, ...
                r_edges, ...
                nBins, ...
                plot_lim ...
            );
            scatter(ax(1), rMesh(:), dens_total(:), 10, 'filled')

            % plotProfiles(ax, r_centres, median_total, median_cold, ratio_cold_total, labelStr, caseColors(iCase, :), '-');
            plotProfiles(ax, r_centres, mean_total_pos, mean_cold_pos, ratio_pos, labelStr, caseColors(iCase, :), '-');
            % plotProfiles( ...
            %     ax, ...
            %     r_centres, ...
            %     median_total, ...
            %     median_cold, ...
            %     ratio_cold_total, ...
            %     labelStr, ...
            %     [0, 0, 0], ...
            %     '-' ...
            % );

        else

            % ----------------------------
            % coord > 0 side
            % ----------------------------
            mask_pos = coordMesh > 0;
            labelStr = sprintf('%s %s > 0', caseNameList{iCase}, asymAxis);

            % [median_total_pos, median_cold_pos, ratio_pos] = calcMedianProfiles( ...
            %     rMesh, ...
            %     dens_total, ...
            %     dens_cold, ...
            %     mask_pos, ...
            %     r_edges, ...
            %     nBins, ...
            %     plot_lim ...
            % );
            [mean_total_pos, mean_cold_pos, ratio_pos] = calcVolumeWeightedProfiles( ...
                rMesh, ...
                dens_total, ...
                dens_cold, ...
                dV, ...
                mask_pos, ...
                r_edges, ...
                nBins, ...
                plot_lim ...
            );
            % plotProfiles(ax, r_centres, median_total_pos, median_cold_pos, ratio_pos, labelStr, caseColors(iCase, :), ':');
            plotProfiles(ax, r_centres, mean_total_pos, mean_cold_pos, ratio_pos, labelStr, caseColors(iCase, :), ':');
            % ----------------------------
            % coord < 0 side
            % ----------------------------
            mask_neg = coordMesh < 0;
            labelStr = sprintf('%s %s < 0', caseNameList{iCase}, asymAxis);

            % [median_total_neg, median_cold_neg, ratio_neg] = calcMedianProfiles( ...
            %     rMesh, ...
            %     dens_total, ...
            %     dens_cold, ...
            %     mask_neg, ...
            %     r_edges, ...
            %     nBins, ...
            %     plot_lim ...
            % );

            [mean_total_neg, mean_cold_neg, ratio_neg] = calcVolumeWeightedProfiles( ...
                rMesh, ...
                dens_total, ...
                dens_cold, ...
                dV, ...
                mask_neg, ...
                r_edges, ...
                nBins, ...
                plot_lim ...
            );
            % plotProfiles(ax, r_centres, median_total_neg, median_cold_neg, ratio_neg, labelStr, caseColors(iCase, :), '--');
            plotProfiles(ax, r_centres, mean_total_neg, mean_cold_neg, ratio_neg, labelStr, caseColors(iCase, :), '--');
        end

    end

    % ----------------------------
    % Axis formatting
    % ----------------------------
    set(ax(1), 'YScale', 'log');
    set(ax(2), 'YScale', 'log');
    set(ax(3), 'YScale', 'log');

    xlabel(ax(1), 'r [km]', 'Interpreter', 'tex');
    xlabel(ax(2), 'r [km]', 'Interpreter', 'tex');
    xlabel(ax(3), 'r [km]', 'Interpreter', 'tex');

    ylabel(ax(1), 'Total n_e [cm^{-3}]', 'Interpreter', 'tex');
    ylabel(ax(2), 'Cold n_e [cm^{-3}]', 'Interpreter', 'tex');
    ylabel(ax(3), 'Cold / total', 'Interpreter', 'tex');

    title(ax(1), 'Total electron density');
    title(ax(2), 'Cold electron density');
    title(ax(3), 'Cold / total ratio');

    % add legend to ax1
    % PLot a 1/r^2 profile for reference thats black 
    r_ref = linspace(1, plot_lim, 3000);
    u_g = 1; % km/s
    % Q_ref = 
    v_i = 7.8e-8; %s^-1
    r_comet = 1.7;
    n_ref =  Q_ref * 1e-15 * (r_ref-r_comet) * v_i ./ (4*pi* u_g.^2 * r_ref.^2); % Normalise to 1e5 at r=10 km
    plot(ax(1), r_ref, n_ref, 'k--', 'LineWidth', 1.5, 'DisplayName', '1/r^2');

    for iAx = 1:3
        xlim(ax(iAx), [0, plot_lim]);
    end

    ylim(ax(3), [0, 1]);

    legend(ax(3), ...
        'Location', 'bestoutside', ...
        'Interpreter', 'none');

    title(t, 'Median Radial Electron Density Profiles');

end
function plotProfiles(ax, r_centres, median_total, median_cold, ratio_cold_total, ...
    labelStr, lineColor, lineStyle)
%PLOTPROFILES Plot total, cold, and ratio profiles onto the three axes.

    plot(ax(1), r_centres, median_total, ...
        'LineWidth', 2.2, ...
        'Color', lineColor, ...
        'LineStyle', lineStyle, ...
        'DisplayName', labelStr);

    plot(ax(2), r_centres, median_cold, ...
        'LineWidth', 2.2, ...
        'Color', lineColor, ...
        'LineStyle', lineStyle, ...
        'DisplayName', labelStr);

    plot(ax(3), r_centres, ratio_cold_total, ...
        'LineWidth', 2.2, ...
        'Color', lineColor, ...
        'LineStyle', lineStyle, ...
        'DisplayName', labelStr);

end

function [mean_total, mean_cold, ratio_cold_total] = calcVolumeWeightedProfiles( ...
    rMesh, dens_total, dens_cold, dV, mask, r_edges, nBins, plot_lim)
%CALCVOLUMEWEIGHTEDPROFILES Calculate volume-weighted mean density profiles.
%
% For each radial bin:
%
%   <n>_V = sum(n_i * dV_i) / sum(dV_i)
%
% The ratio is:
%
%   <n_cold>_V / <n_total>_V

    rVals = rMesh(mask);
    totalVals = dens_total(mask);
    coldVals = dens_cold(mask);
    volVals = dV(mask);

    rVals = rVals(:);
    totalVals = totalVals(:);
    coldVals = coldVals(:);
    volVals = volVals(:);

    valid = isfinite(rVals) & ...
            isfinite(totalVals) & ...
            isfinite(coldVals) & ...
            isfinite(volVals) & ...
            totalVals > 0 & ...
            coldVals > 0 & ...
            volVals > 0 & ...
            rVals <= plot_lim;

    rVals = rVals(valid);
    totalVals = totalVals(valid);
    coldVals = coldVals(valid);
    volVals = volVals(valid);

    [~, ~, bin_idx] = histcounts(rVals, r_edges);
    inBin = bin_idx > 0;

    bin_idx = bin_idx(inBin);
    totalVals = totalVals(inBin);
    coldVals = coldVals(inBin);
    volVals = volVals(inBin);

    % Sum of volume in each radial bin
    vol_sum = accumarray( ...
        bin_idx, ...
        volVals, ...
        [nBins, 1], ...
        @sum, ...
        NaN ...
    );

    % Volume-weighted total density
    total_weighted_sum = accumarray( ...
        bin_idx, ...
        totalVals .* volVals, ...
        [nBins, 1], ...
        @sum, ...
        NaN ...
    );

    mean_total = total_weighted_sum ./ vol_sum;

    % Volume-weighted cold density
    cold_weighted_sum = accumarray( ...
        bin_idx, ...
        coldVals .* volVals, ...
        [nBins, 1], ...
        @sum, ...
        NaN ...
    );

    mean_cold = cold_weighted_sum ./ vol_sum;

    % Cold / total ratio
    ratio_cold_total = mean_cold ./ mean_total;

    bad = ~isfinite(ratio_cold_total) | mean_total <= 0;
    ratio_cold_total(bad) = NaN;

end

function [median_total, median_cold, ratio_cold_total] = calcMedianProfiles( ...
    rMesh, dens_total, dens_cold, mask, r_edges, nBins, plot_lim)
%CALCMEDIANPROFILES Calculate median total/cold density and cold/total ratio.
%
% The ratio is calculated as:
%
%   median(cold density) / median(total density)
%
% in each radial bin.

    rVals = rMesh(mask);
    totalVals = dens_total(mask);
    coldVals = dens_cold(mask);
    ratioVals = coldVals ./ totalVals;

    rVals = rVals(:);
    totalVals = totalVals(:);
    coldVals = coldVals(:);
    ratioVals = ratioVals(:);

    valid_total = isfinite(rVals) & ...
                  isfinite(totalVals) & ...
                  totalVals > 0 & ...
                  rVals <= plot_lim;

    valid_cold = isfinite(rVals) & ...
                 isfinite(coldVals) & ...
                 coldVals > 0 & ...
                 rVals <= plot_lim;
    valid_ratio = isfinite(rVals) & ...
                  isfinite(ratioVals) & ...
                  ratioVals > 0 & ...
                  rVals <= plot_lim;

    % ----------------------------
    % Total density median
    % ----------------------------
    r_total = rVals(valid_total);
    d_total = totalVals(valid_total);

    [~, ~, bin_idx_total] = histcounts(r_total, r_edges);
    inBin_total = bin_idx_total > 0;

    median_total = accumarray( ...
        bin_idx_total(inBin_total), ...
        d_total(inBin_total), ...
        [nBins, 1], ...
        @median, ...
        NaN ...
    );

    % ----------------------------
    % Cold density median
    % ----------------------------
    r_cold = rVals(valid_cold);
    d_cold = coldVals(valid_cold);

    [~, ~, bin_idx_cold] = histcounts(r_cold, r_edges);
    inBin_cold = bin_idx_cold > 0;

    median_cold = accumarray( ...
        bin_idx_cold(inBin_cold), ...
        d_cold(inBin_cold), ...
        [nBins, 1], ...
        @median, ...
        NaN ...
    );

    r_ratio = rVals(valid_ratio);
    d_ratio = ratioVals(valid_ratio);

    [~, ~, bin_idx_ratio] = histcounts(r_ratio, r_edges);
    inBin_ratio = bin_idx_ratio > 0;

    median_ratio = accumarray( ...
        bin_idx_ratio(inBin_ratio), ...
        d_ratio(inBin_ratio), ...
        [nBins, 1], ...
        @median, ...
        NaN ...
    );

    % ----------------------------
    % Cold / total ratio
    % ----------------------------
    ratio_cold_total = median_ratio;
    ratio_cold_total = median_cold ./ median_total;

    badRatio = ~isfinite(ratio_cold_total) | median_total <= 0;
    ratio_cold_total(badRatio) = NaN;

end